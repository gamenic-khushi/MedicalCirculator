# Used only by the Playwright end-to-end build (vite build --mode e2e).
# All values are fake: the endpoint is a host that does not exist, and the tests
# answer every request to it from an in-memory fake (see e2e/support/fakeAppwrite.ts).
VITE_APPWRITE_ENDPOINT=http://appwrite.test/v1
VITE_APPWRITE_PROJECT_ID=e2e-project
VITE_APPWRITE_DATABASE_ID=e2e-database
VITE_APPWRITE_BUCKET_ID=e2e-models
VITE_APPWRITE_DOCUMENTS_BUCKET_ID=e2e-documents
