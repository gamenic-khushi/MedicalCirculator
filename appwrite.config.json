{
    "projectId": "6a85582b0023b5c32287",
    "sites": [
        {
            "$id": "medicalCirculator",
            "name": "medicalCirculator",
            "framework": "vite",
            "adapter": "static",
            "buildRuntime": "node-22",
            "installCommand": "npm install",
            "buildCommand": "npm run build",
            "outputDirectory": "./dist",
            "fallbackFile": "index.html",
            "buildSpecification": "s-8vcpu-8gb",
            "runtimeSpecification": "s-8vcpu-8gb",
            "deploymentRetention": 0,
            "enabled": true,
            "timeout": 30,
            "logging": true,
            "path": "."
        }
    ],
    "functions": [
        {
            "$id": "resolveProximityTiebreak",
            "name": "Resolve Proximity Tiebreak",
            "runtime": "node-16.0",
            "execute": [
                "users"
            ],
            "events": [],
            "schedule": "",
            "timeout": 15,
            "enabled": true,
            "logging": true,
            "entrypoint": "src/main.js",
            "commands": "npm install",
            "path": "functions/resolveProximityTiebreak"
        }
    ]
}
